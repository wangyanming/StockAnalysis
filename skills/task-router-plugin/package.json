{
  "name": "task-router",
  "version": "1.0.0",
  "private": true,
  "description": "Enforces Multi-Agent workflow: blocks main agent from writing files directly",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "src": "src/index.ts",
    "dist": "dist/index.js",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch"
  },
  "peerDependencies": {
    "openclaw": "^2026.3.24-beta.2"
  },
  "devDependencies": {
    "openclaw": "^2026.3.24-beta.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
